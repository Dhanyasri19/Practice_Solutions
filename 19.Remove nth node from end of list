class Solution {
    public ListNode removeNthFromEnd(ListNode headNode, int positionFromEnd) {

        ListNode previousPointer = headNode;
        ListNode forwardPointer = headNode;

        while (positionFromEnd-- > 0) {
            forwardPointer = forwardPointer.next;
        }

        if (forwardPointer == null) {
            return headNode.next;
        }

        while (forwardPointer.next != null) {
            previousPointer = previousPointer.next;
            forwardPointer = forwardPointer.next;
        }

        previousPointer.next = previousPointer.next.next;

        return headNode;
    }
}